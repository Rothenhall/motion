META_APP_ID=1671903081190592
META_APP_SECRET=change_me
META_GRAPH_VERSION=v25.0
META_OAUTH_REDIRECT_URL=http://localhost:3001/auth/facebook/callback
META_FB_REDIRECT_URL=http://localhost:3001/auth/facebook/callback
META_IG_REDIRECT_URL=http://localhost:3001/auth/instagram/callback
META_THREADS_REDIRECT_URL=http://localhost:3001/auth/threads/callback
# Instagram product (Dashboard > Instagram > API setup with Instagram login)
META_IG_APP_ID=change_me
META_IG_APP_SECRET=change_me
# Threads has its own app ID and secret (Dashboard > Use cases > Threads API > Settings)
META_THREADS_APP_ID=change_me
META_THREADS_APP_SECRET=change_me
META_WEBHOOK_VERIFY_TOKEN=change_me_random_string
# AI ideas, hook library and pre-flight checks, via OpenRouter (https://openrouter.ai/keys).
# OPENROUTER_MODEL is optional; it must accept images and support structured outputs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# Optional: TRIBE v2 audience simulation for pre-flight checks on reels (tribe-service/, needs a GPU).
# Leave empty and pre-flight checks use the AI review alone. Internal R&D only: TRIBE v2 is CC BY-NC 4.0.
TRIBE_SERVICE_URL=
TRIBE_SERVICE_TOKEN=
# Local Postgres from `docker compose up -d db` (docker-compose.yml at the repo root)
DATABASE_URL="postgresql://motion:motion@localhost:5432/motion?schema=public"
FRONTEND_URL=http://localhost:3000
PORT=3001
# Signs Motion session tokens and OAuth state. Generate with: openssl rand -base64 48
AUTH_SECRET=change_me_to_a_long_random_string_of_32_chars_or_more
# Encrypts stored Meta access tokens (AES-256-GCM). 32 bytes, base64: openssl rand -base64 32
# Keep it stable: changing it makes every stored token unreadable and channels must be reconnected.
TOKEN_ENCRYPTION_KEY=change_me_base64_32_bytes
# Agency staff: comma separated emails that are admins (they can act as any client). Nobody is promoted unless listed here.
# The very first account created on an empty database is an admin anyway.
ADMIN_EMAILS=
# Sign-up is closed: people join by invitation link from an admin. Set true only for a demo or a single-owner install.
# (The first account on an empty database is always allowed and becomes an admin.)
# ALLOW_SIGNUP=true
