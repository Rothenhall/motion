generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Clients: every workspace (a brand being managed) and who may act in it ----

enum Role {
  ADMIN // agency staff: can act as any client
  CLIENT_POC // a client's main contact
  CLIENT_MEMBER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
}

/// A workspace: one brand's channels, drafts, posts, ideas, hooks, brand voice, checks and analytics.
model Client {
  id              String       @id @default(cuid())
  name            String
  status          ClientStatus @default(ACTIVE)
  seatLimit       Int          @default(3)
  requireApproval Boolean      @default(false)
  notes           String?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  archivedAt      DateTime?
  users           User[]
  accounts        SocialAccount[]
  flags           ClientFeatureFlag[]
  drafts          PostDraft[]
  ideas           ContentIdea[]
  hooks           Hook[]
  checks          ContentCheck[]
  brandProfile    BrandProfile?
  media           MediaFile[]
  creatorShortlist CreatorShortlist[]
}

/// A deliberate on/off choice for one client. A feature with no row uses its default (see src/tenancy/features.constants.ts).
model ClientFeatureFlag {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  featureKey  String
  enabled     Boolean
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([clientId, featureKey])
}

/// An invite or password-reset link. Only a hash of the token is stored, so a database leak does not leak working links.
model AuthToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // INVITE | RESET
  tokenHash   String    @unique // sha256 of the token
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([userId, type])
}

/// What staff did to a client's workspace: who, what and when. Kept even if the user or client is later removed.
model AdminAuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String
  clientId   String?
  action     String // client.create, channel.disconnect, feature.set, user.invite ...
  targetType String?
  targetId   String?
  meta       Json?

  @@index([clientId, at])
}

/// Who uploaded which file, so one client cannot attach another client's media.
model MediaFile {
  name         String   @id // the stored file name, e.g. 1791274079950-1cea7328.png
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([clientId])
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  role          Role       @default(CLIENT_POC)
  status        UserStatus @default(ACTIVE)
  clientId      String? // client users: their client. admins: their home workspace.
  client        Client?    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invitedById   String?
  failedAttempts Int       @default(0) // wrong passwords in a row; five lock the account for a while
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  sessionVersion Int       @default(0) // bumped to sign a user out everywhere (password reset, disable)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  authTokens    AuthToken[]
  accounts      SocialAccount[]
  brandProfiles BrandProfile[]
  ideas         ContentIdea[]
  hooks         Hook[]
  checks        ContentCheck[]
  drafts        PostDraft[]

  @@index([clientId])
}

model SocialAccount {
  id               String           @id @default(cuid())
  disconnectedAt   DateTime? // set when staff disconnect it: history is kept, publishing and syncing stop, the token is dropped
  userId           String? // who connected it (null only for channels connected before user accounts existed)
  user             User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId         String? // the client workspace that owns this channel
  client           Client?          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  provider         String // facebook_page | instagram | threads
  externalId       String // Page ID / IG ID / Threads User ID
  name             String?
  accessToken      String // AES-256-GCM ciphertext ("enc:v1:..."), see src/auth/crypto.ts
  tokenExpires     DateTime?
  meta             String? // JSON: username, followers/media counts, profile pic
  insightsSyncedAt DateTime?
  insightsError    String? // last insights sync failure (e.g. missing permission)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  posts            ScheduledPost[]
  rules            AutomationRule[]
  comments         CommentEvent[]
  insights         AccountInsight[]
  postInsights     PostInsight[]

  @@unique([clientId, provider, externalId])
  @@index([provider, externalId])
  @@index([clientId])
}

model ScheduledPost {
  id          String        @id @default(cuid())
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform    String // instagram | facebook | threads
  mediaType   String // TEXT | IMAGE | VIDEO | REELS | STORIES | CAROUSEL
  caption     String?
  mediaUrls   String // JSON array string
  scheduledAt DateTime
  status      String        @default("SCHEDULED") // SCHEDULED|PUBLISHING|PUBLISHED|FAILED
  externalId  String?
  error       String?
  permalink   String?
  createdById String? // the user (client user or an admin acting for the client) who scheduled it
  ideaId      String? // the content idea this post was written from
  idea        ContentIdea?  @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  insight     PostInsight?

  @@index([ideaId])
}

/// One normalized account-level metric for one UTC day.
/// metric: followers | views | reach | engagements
model AccountInsight {
  id        String        @id @default(cuid())
  accountId String
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date      DateTime // UTC midnight
  metric    String
  value     Int
  updatedAt DateTime      @updatedAt

  @@unique([accountId, date, metric])
  @@index([date])
}

/// Latest lifetime metrics for a published post. Null = platform doesn't report it.
model PostInsight {
  id          String        @id @default(cuid())
  postId      String        @unique
  post        ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  views       Int?
  reach       Int?
  likes       Int?
  comments    Int?
  shares      Int?
  saves       Int?
  engagements Int?
  fetchedAt   DateTime      @default(now())
}

model AutomationRule {
  id          String        @id @default(cuid())
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  trigger     String        @default("COMMENT_KEYWORD") // COMMENT_KEYWORD | ALL_COMMENTS
  keyword     String?
  replyMode   String        @default("PUBLIC_AND_DM") // PUBLIC | DM | PUBLIC_AND_DM
  publicReply String?
  dmText      String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
}

model CommentEvent {
  id          String   @id @default(cuid())
  accountId   String?  // the connected channel the comment arrived on; null for events from before scoping
  account     SocialAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform    String
  mediaId     String?
  commentId   String
  senderId    String?
  text        String?
  replied     Boolean  @default(false)
  dmSent      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([accountId, commentId])
}

// ---- AI layer: brand context, generated ideas, hook library ----

model BrandProfile {
  id              String    @id @default(cuid())
  userId          String // who last saved it
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId        String?   @unique // one brand profile per client
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  niche           String    // what the brand posts about
  audience        String?   // who it is for
  voice           String?   // tone of voice
  pillars         String    @default("[]") // JSON array of content pillars
  platforms       String    @default("[\"instagram\"]") // JSON array: instagram | facebook | threads
  autopilot       Boolean   @default(false) // generate fresh ideas every morning
  ideasPerRun     Int       @default(5)
  lastAutopilotAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

model ContentIdea {
  id        String   @id @default(cuid())
  userId    String // who created it
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title     String
  hook      String   // opening line
  angle     String?  // why this works / the take
  format    String   // REEL | CAROUSEL | IMAGE | THREAD | TEXT | STORY
  platform  String   // instagram | facebook | threads
  pillar    String?
  caption   String?
  hashtags  String   @default("[]") // JSON array
  status    String   @default("NEW") // NEW | SAVED | USED | DISMISSED
  source    String   @default("MANUAL") // MANUAL | AUTOPILOT
  topic     String?  // the prompt topic it came from
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     ScheduledPost[]

  @@index([clientId, status, createdAt])
}

model Hook {
  id         String   @id @default(cuid())
  userId     String   // who created it
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   String?  // each client gets its own copy of the starter hooks, so favorites stay per client
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  text       String   // may contain [placeholders]
  category   String   // CURIOSITY | CONTRARIAN | STORY | LISTICLE | QUESTION | PROOF | PAIN | HOW_TO
  platform   String?  // null = works anywhere
  source     String   @default("SEED") // SEED | AI | CUSTOM
  topic      String?  // topic it was written for (AI hooks)
  isFavorite Boolean  @default(false)
  usedCount  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([clientId, category])
}

// ---- Pre-flight check: predicted audience reaction before posting ----

/// One piece of content checked before it is posted. Runs as a background job.
model ContentCheck {
  id          String    @id @default(cuid())
  userId      String // who ran it
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  groupId     String?   // versions uploaded together to compare
  label       String?   // "Version A"
  kind        String    // VIDEO | IMAGE | CAROUSEL | TEXT
  platform    String    // instagram | facebook | threads
  caption     String?
  text        String?   // the post itself (TEXT) or the voiceover / on-screen script (VIDEO)
  mediaUrls   String    @default("[]") // JSON array of /media/upload URLs
  mediaHash   String?   // sha256 of the media files
  status      String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  engine      String?   // AI_REVIEW | AUDIENCE_SIMULATION (TRIBE v2 + AI review)
  signals     String?   // JSON: measured video facts and the audience simulation summary
  report      String?   // JSON: the insights shown to the user
  brain       String?   // JSON: per-second simulated cortical map (tribe-service encode_brain), served separately
  brainStatus String?   // RUNNING | FAILED while a "load brain view" run is in flight or after it failed
  error       String?
  attempts    Int       @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId, createdAt])
  @@index([status, createdAt])
  @@index([groupId])
}

/// A post still being written. Unlike ScheduledPost it may lack a channel, a time or even media.
model PostDraft {
  id          String    @id @default(cuid())
  userId      String // who last edited it
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  accountId   String?
  platform    String?
  mediaType   String    @default("IMAGE")
  caption     String?
  mediaUrls   String    @default("[]") // JSON array string
  scheduledAt DateTime?
  ideaId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId, updatedAt])
}

/// An Instagram creator a client saved from the Creators tab. Snapshot of the profile at save time.
model CreatorShortlist {
  id                String   @id @default(cuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId            String
  username          String
  creatorId         String?
  profilePictureUrl String?
  biography         String?
  country           String?
  followers         Int?
  verified          Boolean?
  data              String   @default("{}")
  createdAt         DateTime @default(now())

  @@unique([clientId, username])
  @@index([clientId, createdAt])
}
