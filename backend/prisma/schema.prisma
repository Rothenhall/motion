generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  accounts     SocialAccount[]
  brandProfile BrandProfile?
  ideas        ContentIdea[]
  hooks        Hook[]
}

model SocialAccount {
  id               String           @id @default(cuid())
  userId           String? // null only for channels connected before user accounts existed
  user             User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String // facebook_page | instagram | threads
  externalId       String // Page ID / IG ID / Threads User ID
  name             String?
  accessToken      String // AES-256-GCM ciphertext ("enc:v1:..."), see src/auth/crypto.ts
  tokenExpires     DateTime?
  meta             String? // JSON: username, followers/media counts, profile pic
  insightsSyncedAt DateTime?
  insightsError    String? // last insights sync failure (e.g. missing permission)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  posts            ScheduledPost[]
  rules            AutomationRule[]
  comments         CommentEvent[]
  insights         AccountInsight[]
  postInsights     PostInsight[]

  @@unique([userId, provider, externalId])
  @@index([provider, externalId])
}

model ScheduledPost {
  id          String        @id @default(cuid())
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform    String // instagram | facebook | threads
  mediaType   String // TEXT | IMAGE | VIDEO | REELS | STORIES | CAROUSEL
  caption     String?
  mediaUrls   String // JSON array string
  scheduledAt DateTime
  status      String        @default("SCHEDULED") // SCHEDULED|PUBLISHING|PUBLISHED|FAILED
  externalId  String?
  error       String?
  permalink   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  insight     PostInsight?
}

/// One normalized account-level metric for one UTC day.
/// metric: followers | views | reach | engagements
model AccountInsight {
  id        String        @id @default(cuid())
  accountId String
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date      DateTime // UTC midnight
  metric    String
  value     Int
  updatedAt DateTime      @updatedAt

  @@unique([accountId, date, metric])
  @@index([date])
}

/// Latest lifetime metrics for a published post. Null = platform doesn't report it.
model PostInsight {
  id          String        @id @default(cuid())
  postId      String        @unique
  post        ScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  views       Int?
  reach       Int?
  likes       Int?
  comments    Int?
  shares      Int?
  saves       Int?
  engagements Int?
  fetchedAt   DateTime      @default(now())
}

model AutomationRule {
  id          String        @id @default(cuid())
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  trigger     String        @default("COMMENT_KEYWORD") // COMMENT_KEYWORD | ALL_COMMENTS
  keyword     String?
  replyMode   String        @default("PUBLIC_AND_DM") // PUBLIC | DM | PUBLIC_AND_DM
  publicReply String?
  dmText      String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
}

model CommentEvent {
  id          String   @id @default(cuid())
  accountId   String?  // the connected channel the comment arrived on; null for events from before scoping
  account     SocialAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform    String
  mediaId     String?
  commentId   String
  senderId    String?
  text        String?
  replied     Boolean  @default(false)
  dmSent      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([accountId, commentId])
}

// ---- AI layer: brand context, generated ideas, hook library ----

model BrandProfile {
  id              String    @id @default(cuid())
  userId          String    @unique // one brand profile per user
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  niche           String    // what the brand posts about
  audience        String?   // who it is for
  voice           String?   // tone of voice
  pillars         String    @default("[]") // JSON array of content pillars
  platforms       String    @default("[\"instagram\"]") // JSON array: instagram | facebook | threads
  autopilot       Boolean   @default(false) // generate fresh ideas every morning
  ideasPerRun     Int       @default(5)
  lastAutopilotAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ContentIdea {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  hook      String   // opening line
  angle     String?  // why this works / the take
  format    String   // REEL | CAROUSEL | IMAGE | THREAD | TEXT | STORY
  platform  String   // instagram | facebook | threads
  pillar    String?
  caption   String?
  hashtags  String   @default("[]") // JSON array
  status    String   @default("NEW") // NEW | SAVED | USED | DISMISSED
  source    String   @default("MANUAL") // MANUAL | AUTOPILOT
  topic     String?  // the prompt topic it came from
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, createdAt])
}

model Hook {
  id         String   @id @default(cuid())
  userId     String   // each user gets their own copy of the starter hooks, so favorites stay personal
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String   // may contain [placeholders]
  category   String   // CURIOSITY | CONTRARIAN | STORY | LISTICLE | QUESTION | PROOF | PAIN | HOW_TO
  platform   String?  // null = works anywhere
  source     String   @default("SEED") // SEED | AI | CUSTOM
  topic      String?  // topic it was written for (AI hooks)
  isFavorite Boolean  @default(false)
  usedCount  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId, category])
}
